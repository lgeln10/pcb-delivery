# 正式签名配置。复制成同目录下的 keystore.properties 再填 —— 那个文件已 gitignore。
#
# ★证书与口令绝不进仓(同 iOS 的 *.p8 / *.p12)。丢了就永远无法给已上架的包发升级:
#   安卓商店按签名认应用身份,换签名 = 换了一个 App,老用户升不了级、只能卸载重装。
#   备份到公司密码库,别只存在某个人的电脑上。
#
# 生成(有效期给足,25 年是行业惯例):
#   keytool -genkeypair -v -keystore aios-release.jks -alias aios \
#     -keyalg RSA -keysize 2048 -validity 9125
#
# storeFile 相对 android/ 目录,或写绝对路径。建议放在仓库之外。

storeFile=../../aios-release.jks
storePassword=
keyAlias=aios
keyPassword=
