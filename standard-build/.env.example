# 复制为 .env.local 后填写。不要提交 .env.local。
# cp .env.example .env.local
# 不设置 DATABASE_URL 时，使用内存库和演示数据。

PORT=3005
AUTH_SECRET=
DATABASE_URL=
CONFIG_ENC_KEY=
UPLOAD_DIR=
PUBLIC_BASE_URL=

VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:3005

# 模型密钥。在系统设置里填写时会加密存库，这里是环境变量兜底。
SIXAM_API_KEY=
ARK_API_KEY=
DASHSCOPE_API_KEY=
ARK_MAX_CONCURRENCY=
ARK_MIN_INTERVAL_MS=

# 几何引擎
PCB_WORKER_URL=http://127.0.0.1:8000

# 授权。留空则按系统设置里上传的授权文件。
LICENSE_REQUIRED=
LICENSE_KEY=
LICENSE_SERVER_URL=
