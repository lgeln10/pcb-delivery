{
  "name": "standard-build",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PCB CAM 平台:登录、组织、设置、通知、审计,以及 PCB 制造",
  "scripts": {
    "dev": "tsx server.ts",
    "web:dev": "vite --host 127.0.0.1",
    "web:build": "vite build && node scripts/precompress-dist.mjs dist",
    "web:preview": "vite preview --host 127.0.0.1",
    "start": "tsx server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node --max-old-space-size=6144 node_modules/typescript/bin/tsc --noEmit",
    "typecheck:vue": "node scripts/vue-typecheck-gate.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "prod:bootstrap-admin": "tsx scripts/bootstrap-production-admin.ts",
    "mint:svc-token": "tsx scripts/mint-svc-token.ts",
    "docs:export": "tsx scripts/export-docs.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "verify": "npm run typecheck && npm run typecheck:vue && npm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@larksuiteoapi/node-sdk": "^1.71.0",
    "@lucide/vue": "^1.17.0",
    "@tanstack/vue-query": "^5.101.0",
    "@types/dompurify": "^3.0.5",
    "@types/qrcode": "^1.5.6",
    "@volcengine/tos-sdk": "^2.7.6",
    "ali-oss": "^6.23.0",
    "bcryptjs": "^3.0.2",
    "docxtemplater": "^3.50.0",
    "dompurify": "^3.4.11",
    "drizzle-orm": "^0.44.2",
    "element-plus": "^2.14.1",
    "hono": "^4.12.25",
    "imapflow": "^1.4.2",
    "ip2region": "^2.3.0",
    "mailparser": "^3.9.11",
    "mammoth": "^1.12.0",
    "marked": "^18.0.5",
    "mdb-reader": "^3.2.0",
    "nodemailer": "^9.0.0",
    "openai": "^6.42.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "pg": "^8.21.0",
    "pizzip": "^3.1.7",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.6",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.4",
    "@types/ali-oss": "^6.23.3",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "drizzle-kit": "^0.31.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.0",
    "vue": "^3.5.38",
    "vue-tsc": "^2.2.12"
  }
}
